{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "..",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/automation.ts",
    "../src/contracts.ts",
    "../src/interview.ts",
    "../src/manifest.ts",
    "../src/profiles.ts"
  ]
}
