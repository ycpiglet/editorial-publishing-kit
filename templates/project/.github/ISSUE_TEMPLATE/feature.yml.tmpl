name: Feature or improvement
description: Propose a reusable improvement to {{PROJECT_NAME}}.
title: "[Feature]: "
labels:
  - "type: feature"
  - "status: needs-triage"
body:
  - type: textarea
    id: problem
    attributes:
      label: Problem
      description: Describe the recurring user or maintainer friction before suggesting a solution.
    validations:
      required: true
  - type: textarea
    id: outcome
    attributes:
      label: Desired outcome
    validations:
      required: true
  - type: textarea
    id: local_change
    attributes:
      label: Existing local customization
      description: If you already changed the project, show what changed and why.
  - type: dropdown
    id: scope
    attributes:
      label: Likely scope
      options:
        - This project only
        - The {{PROFILE}} profile
        - Every Editorial Publishing Kit project
        - Unsure
    validations:
      required: true
  - type: textarea
    id: compatibility
    attributes:
      label: Compatibility or migration concerns
